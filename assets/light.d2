# Cyberdream light palette on the GitHub light page background.
vars: {
  bg: "#ffffff"
  panel: "#f6f8fa"
  line: "#d0d7de"
  fg: "#16181a"
  muted: "#57606a"
  blue: "#0057d1"
  magenta: "#a018ff"
  green: "#008b0c"
  cyan: "#008c99"
  blue-tint: "#f1f6ff"
  magenta-tint: "#f8f2ff"
  green-tint: "#eff8f0"
  cyan-tint: "#eef8f9"
}
style.fill: ${bg}
