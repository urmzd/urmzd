# Shared styles for generated maps. Palette comes from light.d2 or dark.d2.
classes: {
  project: {
    width: 240
    height: 76
    style: {
      fill: ${blue-tint}
      stroke: ${blue}
      font-color: ${fg}
      font-size: 20
      border-radius: 10
      stroke-width: 2
    }
  }
  goal: {
    width: 240
    height: 76
    style: {
      fill: ${panel}
      stroke: ${line}
      font-color: ${fg}
      font-size: 20
      border-radius: 10
    }
  }
  dependency: {
    style: {
      stroke: ${blue}
      font-color: ${fg}
      font-size: 17
      stroke-width: 2
    }
  }
  guide: {
    style: {
      stroke: ${muted}
      font-color: ${muted}
      font-size: 17
      stroke-width: 2
      stroke-dash: 4
    }
  }
}
