# Cyberdream dark palette on the GitHub dark page background.
vars: {
  bg: "#0d1117"
  panel: "#16181a"
  line: "#3c4048"
  fg: "#ffffff"
  muted: "#9aa3b2"
  blue: "#5ea1ff"
  magenta: "#bd5eff"
  green: "#5eff6c"
  cyan: "#5ef1ff"
  blue-tint: "#1a2434"
  magenta-tint: "#241c33"
  green-tint: "#19281d"
  cyan-tint: "#18282d"
}
style.fill: ${bg}
